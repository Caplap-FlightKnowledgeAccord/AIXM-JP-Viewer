# ==========================================
# 国土交通省 SWIM サービス接続設定
# ==========================================
# ※ このファイルをコピーして .env を作成し、ご自身のアカウント情報を設定してください。
# ※ .env ファイルは .gitignore により GitHub へのコミット対象から自動除外されます。

# WebAPI ログインアカウントID (メールアドレス)
SWIM_USER_ID=your_account_id@example.com

# WebAPI ログインパスワード
SWIM_PASSWORD=your_password_here

# API エンドポイント　xxxxx部分はSWIMサービス提供者から取得
SWIM_LOGIN_URL=https://top.swim.mlit.go.jp/xxxxx/webapi/login
SWIM_SEARCH_URL=https://web.swim.mlit.go.jp/xxxxx/web/search

# 通信タイムアウト (秒)
SWIM_TIMEOUT=30

# アカウント未設定時や通信失敗時にモックデータでフォールバックするか (true / false)
SWIM_USE_MOCK_FALLBACK=true

# ==========================================
# (参考) AMQP 接続設定 (Pub/Sub配信利用時)
# ==========================================
SWIM_AMQP_BROKER_URL=
SWIM_AMQP_AUTH_ID=
SWIM_AMQP_AUTH_PASSWORD=
SWIM_AMQP_RECEIVE_QUEUE_ID=
SWIM_AMQP_SEND_QUEUE_ID=
